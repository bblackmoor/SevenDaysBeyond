      <property name="icon" value="ui_game_symbol_zombie" />
      <property name="repeatable" value="true" />
      <property name="shareable" value="false" />
      <property name="completiontype" value="AutoComplete" />
      <property name="difficulty" value="easy" />
      <property name="login_rally_reset" value="false" />
      <property name="return_to_quest_giver" value="false" />
      <property name="add_to_tier_complete" value="false" />
      <objective type="EntityKill" id="zombie" value="3" phase="1">
        <property name="target_tags" value="zombie" />
      </objective>
    </quest>
  </append>
</configs>
